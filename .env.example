# PostgreSQL connection string. Require TLS in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public application origin, without a trailing slash.
NEXTAUTH_URL=https://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Upstox OAuth credentials and callback.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://localhost:3000/api/auth/upstox/callback
# Optional; normally leave unchanged.
UPSTOX_API_BASE_URL=https://api.upstox.com

# Brandfetch Logo API. The client ID is the value shown after `?c=` in the
# Brandfetch developer dashboard. It is a public CDN identifier, not a secret.
BRANDFETCH_CLIENT_ID=
# Optional; normally leave unchanged.
BRANDFETCH_LOGO_BASE_URL=https://cdn.brandfetch.io
